{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizbank.dev/schemas/quiz-item.schema.json",
  "title": "Quiz Item",
  "type": "object",

  "required": ["id", "version", "type", "points", "stem"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable item identifier. Never reuse for different content.",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,}$",
      "minLength": 3,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Increment when content changes in a grading-relevant way."
    },
    "type": {
      "type": "string",
      "enum": ["mcq_one", "mcq_multi", "true_false", "numeric", "short_answer", "fill_blank", "essay", "code_review", "matching", "ordering"],
      "description": "Question type."
    },
    "points": { "type": "number", "minimum": 0 },
    "topic": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "category_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,}$" },
      "uniqueItems": true
    },
    "outcomes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "maxItems": 20
    },
    "attachments": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Relative file paths to media required by the item."
    },
    "shuffle_choices": { "type": "boolean", "description": "Shuffle choices for MCQ types." },
    "stem": {
      "type": "string",
      "minLength": 1,
      "contentMediaType": "text/markdown",
      "description": "Problem statement in Markdown. Math allowed."
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correct": { "type": "string" },
        "incorrect": { "type": "string" }
      }
    },
    "solution": {
      "type": "string",
      "description": "Fully worked solution or grading notes.",
      "contentMediaType": "text/markdown"
    },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "source": {
      "type": "object",
      "description": "Optional provenance for the question.",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "Extra data retained for exporters that understand it.",
      "additionalProperties": true
    },
    "shuffle_answers": {
      "type": "boolean",
      "description": "Indicates if answers should be shuffled for this quiz item."
    },
    "allowed_attempts": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of attempts allowed for this quiz item."
    }
  },

  "allOf": [
    {
      "oneOf": [
        { "$ref": "#/$defs/mcq_one" },
        { "$ref": "#/$defs/mcq_multi" },
        { "$ref": "#/$defs/true_false" },
        { "$ref": "#/$defs/numeric" },
        { "$ref": "#/$defs/short_answer" },
        { "$ref": "#/$defs/fill_blank" },
        { "$ref": "#/$defs/essay" },
        { "$ref": "#/$defs/code_review" },
        { "$ref": "#/$defs/matching" },
        { "$ref": "#/$defs/ordering" }
      ]
    }
  ],

  "unevaluatedProperties": false,

  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "contentMediaType": "text/markdown" },
        "correct": { "type": "boolean", "default": false },
        "rationale": { "type": "string", "description": "Why this choice is right or wrong." }
      }
    },

    "accepted_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "regex": { "type": "boolean", "default": false },
        "case_sensitive": { "type": "boolean", "default": false },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "mcq_one": {
      "title": "Multiple Choice (single correct)",
      "type": "object",
      "properties": {
        "type": { "const": "mcq_one" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/choice" },
          "contains": {
            "type": "object",
            "properties": { "correct": { "const": true } },
            "required": ["correct"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": ["choices"]
    },

    "mcq_multi": {
      "title": "Multiple Select",
      "type": "object",
      "properties": {
        "type": { "const": "mcq_multi" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/choice" },
          "contains": {
            "type": "object",
            "properties": { "correct": { "const": true } },
            "required": ["correct"]
          },
          "minContains": 1
        }
      },
      "required": ["choices"]
    },

    "true_false": {
      "title": "True or False",
      "type": "object",
      "properties": {
        "type": { "const": "true_false" },
        "answer": { "type": "boolean" }
      },
      "required": ["answer"]
    },

    "numeric": {
      "title": "Numeric response",
      "type": "object",
      "properties": {
        "type": { "const": "numeric" },
        "answer": { "type": "number", "description": "Correct numeric answer", "not": { "type": "string" } },
        "tolerance": { "type": "number", "minimum": 0, "default": 0, "description": "Acceptable range of error" },
        "unit": { "type": ["string", "null"], "description": "Optional unit for the answer" }
      },
      "required": ["answer", "tolerance"]
    },

    "short_answer": {
      "title": "Short answer",
      "type": "object",
      "properties": {
        "type": { "const": "short_answer" },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accepted_answer" }
        }
      },
      "required": ["answers"]
    },

    "fill_blank": {
      "title": "Fill in the blank",
      "type": "object",
      "properties": {
        "type": { "const": "fill_blank" },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/accepted_answer" }
        }
      },
      "required": ["answers"]
    },

    "essay": {
      "title": "Essay or manually graded response",
      "type": "object",
      "properties": {
        "type": { "const": "essay" },
        "response_lines": { "type": "integer", "minimum": 1, "default": 8 },
        "rubric": { "type": "string", "contentMediaType": "text/markdown" },
        "sample_answer": { "type": "string", "contentMediaType": "text/markdown" }
      }
    },

    "code_review": {
      "title": "Code review with follow-up prompts",
      "type": "object",
      "properties": {
        "type": { "const": "code_review" },
        "code": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "default": "text" },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "contentMediaType": "text/markdown" }
        },
        "answers": {
          "type": "array",
          "items": { "type": "string", "contentMediaType": "text/markdown" }
        },
        "response_lines": { "type": "integer", "minimum": 1, "default": 3 }
      },
      "required": ["code", "prompts"]
    },

    "matching": {
      "title": "Matching",
      "type": "object",
      "properties": {
        "type": { "const": "matching" },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 }
            }
          }
        },
        "shuffle_pairs": { "type": "boolean" }
      },
      "required": ["pairs"]
    },

    "ordering": {
      "title": "Ordering",
      "type": "object",
      "properties": {
        "type": { "const": "ordering" },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "shuffle_items": { "type": "boolean" }
      },
      "required": ["items"]
    }
  }
}
